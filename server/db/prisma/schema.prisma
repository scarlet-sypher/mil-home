generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  username       String
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("sessions")
}

model Quarter {
  id        Int    @id @default(autoincrement())
  quarterNo String @unique
  colony    String
  status    String @default("VACANT") // VACANT | OCCUPIED | RESERVED
  condition String @default("FIT") // FIT | UNFIT

  // Direct occupant fields, filled only via the Quarters-tab "Occupied" form
  serviceNo String?
  rank      String?
  name      String?
  unit      String?

  // True while this quarter has an in-progress maintenance record. The quarter
  // keeps its VACANT/OCCUPIED status and stays visible in that tab, just disabled.
  underMaintenance Boolean @default(false)

  createdAt DateTime @default(now())

  allotments         Allotment[]
  complaints         Complaint[]
  vacations          Vacation[]
  maintenanceRecords MaintenanceRecord[]

  @@map("quarters")
}

model MaintenanceRecord {
  id        Int     @id @default(autoincrement())
  quarterId Int
  quarter   Quarter @relation(fields: [quarterId], references: [id])

  // Snapshot of the quarter at the moment maintenance started, so this entry
  // stays accurate even if the quarter is later edited or re-occupied.
  colony                  String
  quarterNo               String
  statusBeforeMaintenance String // VACANT | OCCUPIED
  condition               String
  serviceNo               String?
  rank                    String?
  name                    String?
  unit                    String?

  remark          String
  status          String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  completedRemark String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  @@map("maintenance_records")
}

model Applicant {
  id            Int         @id @default(autoincrement())
  serviceNo     String      @unique
  name          String
  rank          String
  unit          String
  seniorityDate DateTime
  remarks       String?
  status        String      @default("WAITING")
  createdAt     DateTime    @default(now())
  allotments    Allotment[]
  complaints    Complaint[]
  vacations     Vacation[]

  @@map("applicants")
}

model Allotment {
  id              Int       @id @default(autoincrement())
  applicantId     Int
  applicant       Applicant @relation(fields: [applicantId], references: [id])
  quarterId       Int
  quarter         Quarter   @relation(fields: [quarterId], references: [id])
  authorityStatus String    @default("PENDING")
  orderRef        String?
  createdAt       DateTime  @default(now())

  @@map("allotments")
}

model Complaint {
  id          Int       @id @default(autoincrement())
  quarterId   Int
  quarter     Quarter   @relation(fields: [quarterId], references: [id])
  applicantId Int
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  description String
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | WAITING | BLOCKED | CLOSED
  remark      String?
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  @@map("complaints")
}

model Vacation {
  id               Int       @id @default(autoincrement())
  quarterId        Int
  quarter          Quarter   @relation(fields: [quarterId], references: [id])
  applicantId      Int
  applicant        Applicant @relation(fields: [applicantId], references: [id])
  requestDate      DateTime  @default(now())
  inspectionStatus String    @default("PENDING")
  defects          String?
  clearanceStatus  String    @default("PENDING")

  @@map("vacations")
}

model AuditEvent {
  id        Int      @id @default(autoincrement())
  actor     String
  action    String
  entity    String
  entityId  Int?
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_events")
}
